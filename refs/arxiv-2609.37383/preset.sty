\usepackage{marginnote}
\newcommand{\hide}[1]{}

\usepackage{ifthen,changepage}
\usepackage{xargs}

\newcommandx{\leftmarginnote}[2][2=0pt]
           {\checkoddpage
            \ifoddpage
              {\reversemarginpar\marginnote{#1}[#2]}
            \else
              {\marginnote{#1}[#2]}
            \fi}
\newcommandx{\rightmarginnote}[2][2=0pt]
           {\checkoddpage
            \ifoddpage
              {\marginnote{#1}[#2]}
            \else
              {\reversemarginpar\marginnote{#1}[#2]}
            \fi}




\newcounter{reminder}
\newcommand{\reminder}[1]{\rightmarginnote{\stepcounter{reminder}\textcolor{red}{Note~\arabic{reminder}}}$\langle$~{\sf #1 }~$\rangle$}



\def\note#1
{\marginpar
{$\leftarrow$
\par
\hfuzz=20pt \hbadness=9000 \hyphenpenalty=-100 \exhyphenpenalty=-100
\pretolerance=-1 \tolerance=9999 \doublehyphendemerits=-100000
\finalhyphendemerits=-100000 \baselineskip=6pt
#1}\hfuzz=1pt}


