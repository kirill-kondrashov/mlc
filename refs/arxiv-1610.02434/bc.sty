\newtheorem{thm}{Theorem}[section]
\newtheorem{lem}[thm]{Lemma}
\newtheorem{lemdef}[thm]{Lemma-Definition}
\newtheorem{problem}[thm]{Problem}
\theoremstyle{definition}
\newtheorem{plaindefn}[thm]{Definition}
\newtheorem{rem}[thm]{Remark}
\newtheorem{exple}[thm]{Example}
\newtheorem{exse}[thm]{Exercise}
\theoremstyle{plain}
\newtheorem{conj}[thm]{Conjecture}
\newtheorem{cor}[thm]{Corollary}
\newtheorem{prop}[thm]{Proposition}
\newtheorem{scholium}[thm]{Scholium}
\newtheorem{question}[thm]{Question}
\newenvironment{defn}{\let\defnoldqedsymbol=\qedsymbol\def\qedsymbol{$\triangle$}\pushQED{\qed}\begin{plaindefn}}{\popQED\let\qedsymbol=\defnoldqedsymbol\end{plaindefn}}
\newenvironment{idescription}{\let\idescriptionlabel=\descriptionlabel\def\descriptionlabel##1{\hspace{\labelsep}\textbf{\emph{##1}}}\begin{description}}{\end{description}\let\descriptionlabel=\idescriptionlabel}

\newtheorem{mainthm}{Theorem}
\renewcommand{\themainthm}{\Alph{mainthm}}
\newtheorem{maincor}[mainthm]{Corollary}
\newtheorem{algo}[thm]{Algorithm}
