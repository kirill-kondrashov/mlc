      ENNReal.ofReal (2 * (gridCells : ℝ) / 4 ^ gridDepth) := by
    rw [← ENNReal.ofReal_ofNat 2, ← ENNReal.ofReal_mul (by norm_num)]
    congr 1
    ring
  rwa [e] at h

